VITE_TYPST_RENDER_ENDPOINT=/api/render/typst
VITE_RESUME_INTAKE_ENDPOINT=/api/intake
VITE_RESUME_TAILORING_ENDPOINT=/api/tailor
VITE_TYPST_RENDER_PROXY_TARGET=http://localhost:8787
VITE_ANALYTICS_DEBUG=0
# When set, the frontend ships sanitized analytics events via navigator.sendBeacon to this URL.
# Leave empty to keep analytics local-only (the default). Pair with RESUME_ANALYTICS_SQLITE_PATH on the backend.
VITE_ANALYTICS_ENDPOINT=

PORT=8787
HOST=0.0.0.0
RESUME_STATIC_DIR=dist
TYPST_BIN=typst
TYPST_RENDER_TIMEOUT_MS=10000
TYPST_RENDER_MAX_BODY_BYTES=262144
TYPST_RENDER_ALLOWED_ORIGIN=*

RESUME_INTAKE_ATTEMPT_LIMIT=3
RESUME_INTAKE_MAX_BODY_BYTES=131072
RESUME_INTAKE_MAX_TEXT_CHARS=20000
RESUME_INTAKE_MAX_PDF_BYTES=5242880
RESUME_INTAKE_PDF_OCR_ENABLED=false
RESUME_INTAKE_PDF_OCR_LANGUAGE=eng
RESUME_INTAKE_PDF_OCR_MAX_PAGES=2
RESUME_INTAKE_PDF_OCR_IMAGE_WIDTH=1600
RESUME_INTAKE_PDF_OCR_LOW_CONFIDENCE_THRESHOLD=80

RESUME_TAILORING_ATTEMPT_LIMIT=3
RESUME_TAILORING_MAX_BODY_BYTES=262144
RESUME_TAILORING_MAX_JOB_DESCRIPTION_CHARS=30000

# Persistent per-client AI request limiting.
# If these are left blank, the backend falls back to in-memory process-local counters.
# If your observability sqlite/hmac settings are already configured, the backend will reuse them automatically.
RESUME_AI_USAGE_SQLITE_PATH=
RESUME_AI_USAGE_HMAC_SECRET=
RESUME_AI_USAGE_WINDOW_MINUTES=60
RESUME_AI_USAGE_TRUST_PROXY=false

# OpenAI-compatible model gateway for real AI intake
# Example for your New API instance:
# OPENAI_BASE_URL=https://your-openai-compatible-gateway.example/v1
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=MiniMax-M2.7
OPENAI_TIMEOUT_MS=60000

# Synthetic usability runner
USABILITY_SIM_BASE_URL=http://127.0.0.1:5174
USABILITY_SIM_HEADLESS=1
USABILITY_SIM_HEURISTIC_ONLY=0
# Frontend analytics ingestion. Stores sanitized events in a dedicated sqlite file.
# RESUME_ANALYTICS_SUMMARY_TOKEN gates GET /api/analytics/summary; without it, the summary returns 401 but
# POST /api/analytics/event still accepts events.
RESUME_ANALYTICS_SQLITE_PATH=
RESUME_ANALYTICS_SUMMARY_TOKEN=
RESUME_ANALYTICS_HMAC_SECRET=
